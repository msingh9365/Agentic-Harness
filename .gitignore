# never commit data, caches, or downloaded code
data/
raw/
hf-git/
quovadis-speakeasy/
windows_emulation_*/
*.json.gz
*.err
.cache/
__pycache__/
*.pyc
.venv/
venv/
nebula/
*.parquet
*.arrow
*.npy
# model data / checkpoints (large, regenerated by hier_nebula)
hier_data/
*.pt
# ...except the four trained two-level models from REPORT.md §7 (23 MB each)
!results/hier/*/best.pt
# ...and results/hier/data/ (row index + released-Nebula scores); "data/" above would hide the whole folder
!results/hier/data/
!results/hier/data/*.npy

# the pinned Nebula submodule (the rule "nebula/" above would otherwise ignore it)
!third_party/nebula
!third_party/nebula/

# generated kernel folders carry a base64 copy of the code (rebuild with baseline/kaggle/build_kernel.py); pulled outputs
baseline/kaggle/jobs/
results/_probe/
results/_smoke_prep/
results/_tokens_raw*/
results/_gpu_smoke/
results/baseline_raw/
